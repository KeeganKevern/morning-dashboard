FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REFRESH_TOKEN=obtained_by_running_scripts/get-google-refresh-token.js

# Colour theme: standard-dark (default), green-trim-dark, ocean-dark,
# sunset-dark or burnt-orange-dark (the display name, e.g. "Ocean - Dark", also works),
# or rotate for a different one each day
DASHBOARD_THEME=rotate

# On the Pi: when the TV is switched on (comma-separated HH:MM-HH:MM windows),
# and the daily restart, a little before the first window
DASHBOARD_SCREEN_TIMES=04:55-05:30,05:55-06:30,07:55-08:30
DASHBOARD_REBOOT_AT=04:45

# Shared Google Drive folder for the photo tile (the ID from its URL), read through
# the Google sign-in above as small thumbnails
PHOTOS_FOLDER_ID=your_drive_folder_id
# Optional fallback when PHOTOS_FOLDER_ID is not set: a local folder (jpg, png, webp)
# PHOTOS_DIR=C:/path/to/Dashboard Photos

# Job tracker Google Sheet (read with the Google sign-in above)
JOB_TRACKER_SHEET_ID=your_job_tracker_sheet_id

# Confluence, read-only, for each KP project's next step. A scoped read-only
# token needs ATLASSIAN_CLOUD_ID; a classic token can use ATLASSIAN_SITE instead.
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your_atlassian_api_token
ATLASSIAN_CLOUD_ID=your_site_cloud_id
ATLASSIAN_SITE=yoursite.atlassian.net
# The token's expiry date (YYYY-MM-DD); the panel warns 14 days before
ATLASSIAN_TOKEN_EXPIRES=2027-11-20

# TimeTree calendar export, written by scripts/timetree-sync.mjs (pip install timetree-exporter)
TIMETREE_EMAIL=you@example.com
TIMETREE_PASSWORD=your_timetree_password
TIMETREE_CALENDAR_CODE=your_calendar_code
TIMETREE_ICS=C:/path/to/timetree.ics

# Optional: Met Office warnings region code (default yh = Yorkshire & Humber; UK = whole country)
# MET_OFFICE_REGION=yh
