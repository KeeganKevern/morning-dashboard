[Unit]
Description=Morning Dashboard
# Start once the network is up, so the first fetches (Google sign-in) don't fail
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/morning-dashboard
EnvironmentFile=/home/pi/morning-dashboard/.env
Environment=NODE_ENV=production
Environment=PORT=3000
# Only the Pi's own browser needs the page
Environment=HOST=127.0.0.1
# The home network has no working IPv6, and Node's 250 ms per-address
# connect attempts time out on a busy Pi just after boot (ETIMEDOUT)
Environment="NODE_OPTIONS=--dns-result-order=ipv4first --no-network-family-autoselection"
ExecStart=/usr/bin/node /home/pi/morning-dashboard/.output/server/index.mjs
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
